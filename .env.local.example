# Copie este arquivo para .env.local e preencha com suas credenciais.
# .env.local nunca deve ser commitado (já está no .gitignore).

# Anthropic — usada pela extração de dados de voo via IA (src/app/api/extract).
# Nunca exponha esta chave no cliente; ela só é lida em código de servidor.
ANTHROPIC_API_KEY=

# Supabase — Project Settings > API no painel do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
